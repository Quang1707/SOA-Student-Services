# Sao chep thanh .env va thay tat ca CHANGE_ME bang gia tri ngau nhien.
# Tren Windows, uu tien chay scripts/configure-local-secrets.ps1 de tao .env.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
PROFILE_DB_NAME=profile_db
PROFILE_DB_USER=profile_app
PROFILE_DB_PASSWORD=CHANGE_ME_PROFILE_DB_PASSWORD
DOCUMENT_DB_NAME=document_db
DOCUMENT_DB_USER=document_app
DOCUMENT_DB_PASSWORD=CHANGE_ME_DOCUMENT_DB_PASSWORD
AUDIT_DB_NAME=audit_db
AUDIT_DB_USER=audit_app
AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_DB_PASSWORD
RABBITMQ_USER=student_app
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
JWT_EXPIRATION_SECONDS=86400
JWT_ISSUER=student-profile-auth-service
INTERNAL_SERVICE_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY

# Audit Service trong Docker: Eureka duoc truy cap qua DNS noi bo cua Compose.
EUREKA_SERVER_URL=http://discovery-server:8761/eureka
EUREKA_INSTANCE_HOSTNAME=audit-notification-service
EUREKA_INSTANCE_ID=audit-notification-service:audit-notification-service:8083
EUREKA_HEARTBEAT_MS=30000

# Thu muc upload duoc mount vao named volume document_uploads.
DOCUMENT_STORAGE_DIR=/app/uploads

{
  "info": {
    "_postman_id": "a6e3cba2-82a8-4a7b-aef6-7b8d7a4b0707",
    "name": "TH7 - Student Profile Service Discovery",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Đăng nhập một lần, sau đó gửi 20 request độc lập qua Gateway -> Document Service -> Eureka/LoadBalancer -> Profile Service. Chạy toàn bộ collection để tổng hợp instanceId và xác nhận quan sát được ít nhất hai Profile instance."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Login (admin01)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin01\",\n  \"password\": \"DemoPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.accessToken) pm.collectionVariables.set('token', body.accessToken);",
              "pm.collectionVariables.set('discoverySeenInstances', '[]');",
              "pm.collectionVariables.set('discoveryRequestCount', '0');",
              "pm.test('Login successful', function () { pm.response.to.have.status(200); pm.expect(body.accessToken).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Discovery request 01/20",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/documents/discovery/profile-instance-info",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "documents",
            "discovery",
            "profile-instance-info"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 from Document -> Profile discovery', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Profile service metadata is valid', function () {",
              "  pm.expect(body.serviceId).to.eql('profile-service');",
              "  pm.expect(body.instanceId).to.be.a('string').and.not.empty;",
              "  pm.expect(body.instancePort).to.be.oneOf([8081, 8084]);",
              "});",
              "let seen = JSON.parse(pm.collectionVariables.get('discoverySeenInstances') || '[]');",
              "if (!seen.includes(body.instanceId)) seen.push(body.instanceId);",
              "pm.collectionVariables.set('discoverySeenInstances', JSON.stringify(seen));",
              "const count = Number(pm.collectionVariables.get('discoveryRequestCount') || '0') + 1;",
              "pm.collectionVariables.set('discoveryRequestCount', String(count));"
            ]
          }
        }
      ]
    },
